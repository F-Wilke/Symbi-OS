/* This adaptor creates and installs a idt that directs all the
   vectors configured to use task state segment (TSS) rsp0 to instead
   use TSS IST7 which we configure to be a dedicated exception frame
   stack.  This way when any of these exceptions occur the hardware
   will always switch to this stack and spill the exception frame.

   We then use a special software handler on these exceptions that
   determines what stack to use and transfers the exception frame
   there to continue processing */
#include <linux/percpu.h>
#include <asm/processor.h>
#include <linux/module.h>
#include <asm/text-patching.h>
#include <linux/stop_machine.h>
#include <asm/irq_vectors.h>
#include <asm/desc.h>
#include <asm/idtentry.h>

#include "idtadaptor.h"
#include "nmiadaptor.h"
#include "efadaptor.kh"

#define VERBOSE 

#define ALL_VECTORS

//#define EF_STACK_DEBUG

#ifdef EF_STACK_DEBUG
extern unsigned long ef_stacks[512];  /* 4096 bytes / 8 = 512 entries */
extern unsigned long ef_stack_check_skip;
#endif

// for debugging you can try and use the NMI IST if ours is
// causing problems
#ifndef EF_ADAPTOR_USE_NMI_IST
#define IST_INDEX_EF 6
#else
#define IST_INDEX_EF IST_INDEX_NMI
#endif

extern unsigned char ef_adaptor_isr_len[];
extern unsigned long ef_adaptor_isrs[];

// patching using text_poke was not possible in module
// so rather than hacking a text patch decide to go with a
// jump table
unsigned long ef_adaptor_orig_isrs[IDT_ENTRIES] = {0};

int extension_init(void);

#ifdef VERBOSE
#define VINFO(...) pr_info(__VA_ARGS__)
#else
#define VINFO(...)
#endif

#define NR_TSTHDLR_DATA 5
static DEFINE_PER_CPU(unsigned long[NR_TSTHDLR_DATA],ef_adaptor_tsthdlr_data);


void ef_adaptor_print_tsthdlr_data(void)
{
  unsigned long *data;	
  int cpu = smp_processor_id();
  
  data = (unsigned long *)this_cpu_ptr(&ef_adaptor_tsthdlr_data);
  pr_info("%s: CPU %d: dumping ef_adaptor_tsthdlr_data\n", __func__, cpu); 
  for (int i=0; i<NR_TSTHDLR_DATA; i++) {      
    pr_info("%s: CPU %d:   ef_adaptor_print_tsthdlr_data[%d]=%016lx\n",
	    __func__, cpu, i, ef_adaptor_tsthdlr_data[i]);
  }
}

static __attribute__((used)) void ef_adaptor_tsthdlr(unsigned long *rsp)
{
  unsigned long *data;
  
  data = (unsigned long *)this_cpu_ptr(&ef_adaptor_tsthdlr_data);
  for (int i=0; i<NR_TSTHDLR_DATA; i++) {
    // skip first rsp value which is the rdi pushed by asm code below
    data[i] = rsp[i+1];
  }
}

// Assembly wrapper (needed for call to test C handler"
// swapgs so that per-cpu kernel code is safe
// JA FIXME: Does not ensure 16 byte stack alignment prior to call
//           C code as required by SysV ABI
asm(
"   .global ef_adaptor_tsthdlr_asm\n"
"ef_adaptor_tsthdlr_asm:\n"
"   cld\n"
"   swapgs\n"
"   pushq %rdi\n"
"   movq  %rsp, %rdi\n"	
"   call ef_adaptor_tsthdlr\n"
"   pop  %rdi\n"
"   swapgs\n"
"   iretq\n"
);

extern void ef_adaptor_tsthdlr_asm(void);


unsigned long df_handler_location = 0; // set to non-zero to redirect df handler to our handler for testing

// FIXME: JA to use idt adaptor interfaces
struct dtr
{
  uint16_t limit; // limit 2
  uint64_t base;   // base 8
}__attribute__((packed));

struct idt_entry {
	uint16_t offset0;
	uint16_t selector;
	uint16_t ist : 3;
	uint16_t : 5;
	uint16_t type : 4;
	uint16_t : 1;
	uint16_t dpl : 2;
	uint16_t p : 1;
	uint16_t offset1;
	uint32_t offset2; uint32_t reserved;
};

void set_local_df_handler_location(void) {
  struct dtr idtr;
  struct idt_entry *idt;
    
  asm volatile ("sidt %0" : "=m" (idtr));

  idt = (struct idt_entry *)idtr.base;
  
  unsigned int df_index = X86_TRAP_DF;
  unsigned long offset = ((uint64_t)idt[df_index].offset2 << 32) |
                          ((uint64_t)idt[df_index].offset1 << 16) |
                          (uint64_t)idt[df_index].offset0;

  printk("Current DF handler offset: 0x%016lx\n", offset);

  df_handler_location = offset;
}


// to stop faults on the memory we use on the
// exception path we must prefault it
// pesmistically we are touching all the module memory
// not actually needed we could restrict ourselves
// to the pages that contain the code and data but
// to be save we are doing all of the module memmory
static void touch_pages(void)
{
    struct module *mod = THIS_MODULE;
    unsigned long addr;
    void *base = mod->mem[MOD_TEXT].base;
    unsigned int size = mod->mem[MOD_TEXT].size;
    
    for (addr = (unsigned long)base;
         addr < (unsigned long)base + size;
         addr += PAGE_SIZE) {        
        volatile unsigned char dummy = *(unsigned char *)addr;
        (void)dummy;
        VINFO("ef_adaptor: prefaulted: %lx\n", addr);
    }
}

//lock for modifying shared "return value"
DEFINE_SPINLOCK(ef_adaptor_lock);


static void ef_adaptor_setup_tss(void* arg) {
  int* rc                      = (int *)arg;
  struct tss_struct *tss       = NULL;
  unsigned long efstack        = 0;
  int cpu                      = smp_processor_id();


    tss = this_cpu_ptr(&cpu_tss_rw);
  if (tss->x86_tss.ist[IST_INDEX_EF] == 0) {
    // GFP_KERNEL   Normal kernel allocation, can sleep
    // __GFP_ZERO   Zero pages
    // order is 0 --> 1 Page
    efstack = __get_free_pages(GFP_KERNEL | __GFP_ZERO, 0);
    if (efstack == 0 ) {
      pr_err("%s: CPU %d: failed to allocate memory\n", __func__, cpu);
      //acquire lock to update shared "return value" that indicates failure to main thread
      spin_lock(&ef_adaptor_lock);
      *rc |= -ENOMEM;
      spin_unlock(&ef_adaptor_lock);
      return;
    }
    // being paranoid touch ef stack page just incase
    volatile unsigned char dummy = *(unsigned char *)efstack;
    (void)dummy;
        
    // install in to tss for IST_INDEX_EF (IST7)
    tss->x86_tss.ist[IST_INDEX_EF] = efstack + PAGE_SIZE;  // set to top
#ifdef EF_STACK_DEBUG
    WRITE_ONCE(ef_stacks[cpu], efstack);
    smp_wmb();
    pr_info("%s: CPU %d: EF_STACK_DEBUG: registered page %lx at in ef_stacks %d\n",
	    __func__, cpu, efstack, cpu);
#endif	    
  } else {
    pr_warn("%s: CPU %d: tss.ist[%d] already set: %llx\n", __func__, cpu,
	    IST_INDEX_EF, tss->x86_tss.ist[IST_INDEX_EF]);
  }

  VINFO("%s: CPU %d: IST7 (ist index %d) stack top=%llx\n", __func__, cpu,
	  IST_INDEX_EF, tss->x86_tss.ist[IST_INDEX_EF]);
}

static void ef_adaptor_cleanup_tss(void* arg) {
  struct tss_struct *tss       = NULL;
  int cpu                      = smp_processor_id();
  
  tss = this_cpu_ptr(&cpu_tss_rw);
  if (tss->x86_tss.ist[IST_INDEX_EF] != 0) {
    tss->x86_tss.ist[IST_INDEX_EF] = 0;
#ifdef EF_STACK_DEBUG    
    WRITE_ONCE(ef_stacks[cpu], 0);
    smp_wmb();
    pr_info("%s: CPU %d: EF_STACK_DEBUG: unregistered for %d\n",
	    __func__, cpu, cpu);
#endif	    
    free_pages(tss->x86_tss.ist[IST_INDEX_EF] - PAGE_SIZE, 0);
    VINFO("%s: CPU %d: cleaned up IST7 (ist index %d) stack\n", __func__, cpu,
      IST_INDEX_EF);
    
  } else {
    pr_warn("%s: CPU %d: tss.ist[%d] already cleared\n", __func__, cpu,
      IST_INDEX_EF);
  }
}

static int process_vec(int cpu, gate_desc *idt, int tsthdlr, int vec)
{
  unsigned long isr_len = (unsigned long)&ef_adaptor_isr_len;
  unsigned char *isrs   = (unsigned char *)&ef_adaptor_isrs;
  unsigned long hdlr    = 0;
  gate_desc   gate;

  read_gate(idt, vec, &gate);
  pr_info("%s: CPU %d: procesing gate: %d: hdlr=%lx IST=%d typ=%d dpl=%d p=%d\n",
	  __func__, cpu,vec, hdlr, gate.bits.ist,
	  gate.bits.type, gate.bits.dpl, gate.bits.p);

    // for the moment we are not skipping non-present entries but
    // we will need to think about what happens when some install a new 
    // interrupt handler and if this our ist setting will persist
    // but not today's problem
  
  if (gate.bits.p != 0 && tsthdlr) {
    // if we have been direct to install the test handler
    // then for all non-present entires we pretented the test
    // handler was already installed
    gate.segment      = __KERNEL_CS;
    gate.bits.type    = GATE_INTERRUPT;
    gate.bits.ist     = 0;   // will be set correctly lower down
    gate.bits.dpl     = 3;
    gate.bits.p       = 1;
    gate.bits.zero    = 0;
    gate_set_offset(&gate, (unsigned long)ef_adaptor_tsthdlr_asm);	
    VINFO("%s:   CPU %d: IDT gate %d INSTALLING test handler\n",
	  __func__, cpu, vec);
  }
  
  // grab original handler this might be the test handler if it was
  // set above
  hdlr = gate_offset(&gate);

  //special case NMI: install our shim
  if (vec == NMI_VECTOR) {
    if (hdlr == (unsigned long)nmi_adaptor_asm_exc_nmi) {
       pr_err("CPU %d: IDT Entry %d handler MISMATCH! "
        "NMI interposition already active\n",
        cpu, vec);
      return -1;
    }

    nmi_adaptor_asm_exc_nmi = (void*)hdlr;
    hdlr = (unsigned long)&nmi_asm_check_ist7;

    VINFO("%s:     CPU %d: IDT gate %d saved %lx new handler %lx\n", __func__,
	    cpu, vec, (unsigned long)nmi_adaptor_asm_exc_nmi, (unsigned long)&nmi_asm_check_ist7);

  }
  else {
    // value zero is reseved as don't use an ist stack
    if (gate.bits.ist != 0) {
      VINFO("%s:   CPU %d: IDT gate %d already using and IST: %d skipping\n",
      __func__, cpu, vec, gate.bits.ist);
      return 0;
    }
    gate.bits.ist = IST_INDEX_EF + 1; // note must add one to index!!! 
    
    // record vector's original handler that runs on rsp0
    unsigned long expected  = 0;
    unsigned long savedhdlr = cmpxchg(&ef_adaptor_orig_isrs[vec], expected, hdlr);
    if (savedhdlr != 0 && savedhdlr != hdlr) {
      // MISMATCH! Different CPUs have different handlers
      pr_err("CPU %d: IDT Entry %d handler MISMATCH! "
       "Expected %lx, found %lx in array\n",
       cpu, vec, hdlr, savedhdlr);
      return -1;
    }
    
    VINFO("%s:     CPU %d: IDT gate %d saved %lx new handler %lx\n", __func__,
    cpu, vec, hdlr, (unsigned long)&isrs[isr_len*vec]);
    
    // update gate to point to new ef vector specific isr
    hdlr = (unsigned long)&(isrs[(isr_len*vec)]);		    
  }
  
  gate_set_offset(&gate, hdlr);
  
  write_idt_entry(idt, vec, &gate);
  
  VINFO("%s:     CPU %d: IDT gate: %d SET to hdlr=%lx IST=%d typ=%d dpl=%d p=%d\n",
	__func__, cpu, vec, hdlr, gate.bits.ist, gate.bits.type,
	gate.bits.dpl, gate.bits.p);    
  return 1;
}

long ef_adaptor_init(int *vecs, int vecs_nr, int vstart, int vend, int tsthdlr)
{
  unsigned long isr_len = (unsigned long)&ef_adaptor_isr_len;
  unsigned char *isrs   = (unsigned char *)&ef_adaptor_isrs;
  int cpu                      = smp_processor_id();
  gate_desc * idt              = NULL;		
  int dirty                    = 0;
  int rc                       = 0;

  /*** TOUCH_PAGES: Ensure all pages of this module are in page table to ensure no
       pagefaults of any kind can happen on isr paths ***/
  touch_pages();

#ifdef EF_STACK_DEBUG
  // number of bytes at the bottom (high address of the stack page we expect can be non-zero) and therefore should be
  // skipped when checking the exception frame stack page
  ef_stack_check_skip   = (6 * 8); // maximum size of hardware pushed exception frame 6 quad words (includes error code)
  ef_stack_check_skip += (1 * 8); // ef_isr_x pushes original exception handler on to ef_stack
  ef_stack_check_skip  += (3 * 8); // we use 3 more quad words as spill space (popped off prior to) ret to original handler
#endif
  // allocate and install an exception stack page on all cpu's
  on_each_cpu(ef_adaptor_setup_tss, &rc, 1); // 1 means wait for completion of all CPUs before returning
  // rc is or of all processor rc's if non-zero at least one core failed
  if (rc<0) {
    pr_err("%s: CPU %d: A CPU failed to setup tss with rc=%d\n", __func__, cpu, rc);
    goto error;
  }
  VINFO("%s: CPU %d: isr_len=%lu isrs=%lx\n", __func__, cpu,
	isr_len, (unsigned long)isrs);

  // setup a new idt that uses IST7 for the non-ist in the range
  idt = idt_adaptor_clone();
  // so that we only modify the fields we care about we read the entire gate
  // update the fields we care about and write it back to the table.
  for (int i=0; i<vecs_nr; i++) {
    rc = process_vec(cpu, idt, tsthdlr, vecs[i]);
    if (rc<0) goto error;
    dirty += rc;
  }

  if (vstart >= 0 && vend > vstart) {
    for (int vec=vstart; vec<=vend; vec++) {
      rc = process_vec(cpu, idt, tsthdlr, vec);
      if (rc<0) goto error;
      dirty += rc;
    }
  }

  smp_wmb(); // ensure all updates to shared memory are visible on all cores -- specifically we
             // are worried about idt and isr cache

  if (dirty) {
    idt_adaptor_activate((gate_desc *)idt); // 1 means wait for completion of all CPUs before returning
    VINFO("%s: CPU %d: updated %d idt entries ACTIVATED new idt\n", __func__, cpu,
	  dirty);
  } else {
    idt_adaptor_release(idt);
    VINFO("%s: CPU %d: updated %d idt entries RELEASE new idt\n", __func__, cpu,
	  dirty);
  }
  // even if we did not set any idt entries to our new ist stack we leave it in
  // place on IST7 we only remove it if there was an error
  return dirty;
  // return;
 error:
  pr_err("%s: CPU: %d: ERROR FAILED: freeing resources and releasing new idt\n",
	 __func__, cpu);
  on_each_cpu(ef_adaptor_cleanup_tss, NULL, 1); // 1 means wait for completion of all CPUs before returning
  if (idt) idt_adaptor_release(idt);
  return -EINVAL;
  // return;
}

int extension_init(void)
{
#ifndef ALL_VECTORS
  int vecs[]        = { X86_TRAP_PF, LOCAL_TIMER_VECTOR };
  const int vecs_nr = sizeof(vecs)/sizeof(int);
  int vstart        = -1;
  int vend          =  0;
#else
  int *vecs         = NULL;
  const int vecs_nr = 0;
  int vstart        = 0;
  int vend          = 255;
#endif

  set_local_df_handler_location();
  
  int tsthdlr = 0; // set to one to install test handler on all non-present entries
  int ret = 0;
  pr_info("%s: Initializing %d vectors tsthdlr=%d:\n", __func__, vecs_nr,  tsthdlr);
  for (int i=0; i<vecs_nr; i++) {
    pr_info("   vecs[%d]=%d\n", i, vecs[i]);
  }
  pr_info("%s: Initializing vectors from %d to %d tsthdlr=%d\n", __func__, vstart, vend, tsthdlr);
  
  ret = ef_adaptor_init(vecs, vecs_nr, vstart, vend, tsthdlr);
  
  pr_info("%s: Initialization complete with ret=%d\n", __func__, ret);


  if (ret > 0) 
    ret = 0; // if we updated any entries return 0 for success
  return ret;
}

MODULE_INFO(kld, "SHARED");