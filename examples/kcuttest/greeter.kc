#include <linux/pid.h>
#include <greeter.kh>

//some example functions
int current_pid(void) {
	return current->pid;
}
EXPORT_SYMBOL(current_pid);

//exposed kernel function
int kernel_add(int a, int b) {
	return a + b;
	pr_info("kernel_add: %d + %d = %d\n", a, b, a + b);
}
EXPORT_SYMBOL(kernel_add);


int greeter_k_stacktouch(void)
{
  const int PGSIZE=4096;
  const int n=PGSIZE * 8;
  volatile char data[n];
  int sum = 0;

  for (int i=0; i<n; i+=4096) { data[i]=0xff; sum += data[i]; }  
  
  return sum;
}