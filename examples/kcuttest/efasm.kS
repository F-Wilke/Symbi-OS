/*
	.glob ef_isr_x
	.glob ef_isr_tgt_x
	.align 8
ef_isr_x:	
	subq $8, %rsp
	push %rdi
	movq ef_isr_tgt_x(%rip), %rdi
	movq %rdi, 8(%rsp)
	pop  %rdi
	jmp  common_ef_hdlr
	.align 8
ef_isr_tgt_x:
	.quad 0
	*/

	.text
	.align 16
	.global ef_common_hdlr
ef_common_hdlr:
	jmp ef_common_hdlr

	// switched to using a table to avoid code patching
#define ef_isr(i)	 			\
	.global ef_adaptor_isr_##i	;	\
	.align 32			;	\
ef_adaptor_isr_##i:			;	\
	subq $8, %rsp			;	\
	push %rdi			;	\
	movq ef_adaptor_orig_isrs + ##i(%rip), %rdi ;	\
	movq %rdi, 8(%rsp)		;	\
	pop  %rdi			;	\
	jmp ef_common_hdlr
	
	.text
	.global ef_adaptor_isrs
	.align 32
