#ifndef APP_KH
#define APP_KH

/*
 * Back-linkage declarations for kcuttest.
 *
 * Tag functions with __user_fn__ and data with __user_data__.
 * genappheader parses this file and generates:
 *   app.h      — kernel-side extern slots + typed call wrappers
 *   app_init.h — slot definitions (included once by init.c)
 */

__user_fn__   int user_add(int a, int b);
__user_data__ int user_counter;

#endif /* APP_KH */

