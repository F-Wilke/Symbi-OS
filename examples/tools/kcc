#!/bin/bash
#set -x
scriptdir=$(dirname $(realpath $0))
configdir=$scriptdir/config
srcdir=$scriptdir/src
kld=${srcdir}/kld/kld

findSymlib()
{
    function fsymlib() {
	if [[ -d Symlib ]]; then
	    echo $(pwd -P)/Symlib
	elif [[ $(pwd -P) != / ]]; then
	    cd ..
	    fsymlib
	fi
    }
    cd $scriptdir
    fsymlib
}

findlinuxdir()
{
    if [[ -d linux ]]; then
	echo $(pwd -P)/linux
    elif [[ $(pwd -P) != $HOME ]]; then
	cd ..
	findlinuxdir
    fi
}

usage()
{
    echo "USAGE: kcc [-o out] [-n name] [-I include_dir] [-K module_search_dir] [-k module.ko] [source]" > /dev/stderr
}

[[ -z $LINUX_BUILD_PATH ]] && [[ -a $configdir/LINUX_BUILD_PATH ]] \
    && LINUX_BUILD_PATH=$(< $configdir/LINUX_BUILD_PATH)

[[ -z $LINUX_BUILD_PATH ]] && LINUX_BUILD_PATH=$(findlinuxdir)

[[ -z $LINUX_BUILD_PATH ]] && {
    echo "ERROR: LINUX_BUILD_PATH not set.  Either environment variable to path of your linux build or put path in $configdir/LINUX_BUILD_PATH" > /dev/stderr
    exit -1
}

symlibdir=$(findSymlib)

[[ -z $symlibdir ]] && {
    echo "ERROR: can't seem to find a Symlib. Need to checkout Symlib and build it." > /dev/stderr
    exit -1
}
   
[[ -d $symlibdir/dynam_build/libSym.so ]] && {
    echo "ERROR: can't find $symlibdir/dynam_build/libSym.so ... maybe you need to build it." > /dev/stderr 
    exit -1
}

LINUX_BUILD_PATH=${LINUX_BUILD_PATH:-$(realpath ../linux)}
curdir=$PWD
tmpdir=$curdir/.ext

[[ ! -d $tmpdir ]] && mkdir $tmpdir

target=ext.ko
name=${target%.ko}
typeset -i topt=0
typeset -i nopt=0
declare -a include_dirs
declare -a module_search_dirs
declare -a dep_modules

while getopts ":n:o:I:K:k:h" o; do
    case "${o}" in
	h)
	    usage
	    exit 1
	    ;;
	n)
	    name=${OPTARG}
	    nopt=1
	    ;;
	o)
	    target=${OPTARG}
	    topt=1
	    ;;
	I)
	    include_dirs+=("${OPTARG}")
	    ;;
	K)
	    module_search_dirs+=("${OPTARG}")
	    ;;
	k)
	    dep_modules+=("${OPTARG}")
	    ;;
	*)
	    usage
	    exit 1
	    ;;
    esac
done
shift $((OPTIND-1))

(( topt && !nopt )) && {
    name=${target%.ko}
}

if (( $# > 0 )); then
    src=( $@ )
else
    src=( $(find $PWD -maxdepth 1 -name '*.kc' -o -name '*.kh' -o  -name '*.kS') )
fi

(( ! ${#src[@]} ))  && {
    echo "No .kc, .kh or .kS source files" > /dev/stderr
    usage
    exit -1
}

mods=( $(find $PWD -maxdepth 1 -name '*.ko') )
for m in ${mods[@]}; do
    #create a symlink to the .ko in the tmpdir if it doesn't already exist
    [[ ! -a $tmpdir/$(basename $m) ]] && ln -s $m $tmpdir/$(basename $m)
done

declare -a cfiles
declare -a asmfiles

for s in ${src[@]}; do
    [[ ! -a $s ]] && {
	echo "Can't find $s" > /dev/stderr
	continue
    }
    
    # app.kh needs special treatment. It needs to be referenced by a symlink "app_orig.h" in the tmpdir.
    # a generated app.h then includes app_orig.h and defines the GOT based jumps to application code.
    if [[ $s == *app.kh ]]; then
	[[ ! -a $tmpdir/app_orig.h ]] && ln -s $s $tmpdir/app_orig.h
	continue
    fi

    if [[ $s =~ \.kc$ ]]; then 
	t=$(basename ${s%.kc}.c)
	cfiles+=($t)
    elif [[ $s =~ \.kh$ ]]; then
	t=$(basename ${s})
	hfiles+=($t)
    else
	t=$(basename ${s%.kS}.S)
	asmfiles+=($t)
    fi
    [[ ! -a $tmpdir/$t ]] && ln -s $s $tmpdir/$t
done

[[ ! -a $tmpdir/init.c ]] && {
    cat > $tmpdir/init.c <<EOF
#include <linux/module.h>
#include "app.h"

void set_app_got(app_got_t* got);

//  Define GOT
app_got_t* app_got;

//  Define the module metadata.
#define MODULE_NAME "$name"
MODULE_AUTHOR("BU SESA");
MODULE_LICENSE("GPL v2");
MODULE_DESCRIPTION("BU SESA DYNPRIV PROCESS EXTENSION");
MODULE_VERSION("0.1b");

//  Define the name parameter.
static char *name = "dynpriv extension";
module_param(name, charp, S_IRUGO);
MODULE_PARM_DESC(name, "The name to display in /var/log/kern.log");

extern int extension_init(void) __attribute__((weak));
static int __init ext_init(void)
{
  pr_info("%s: module loaded at 0x%p\n", MODULE_NAME, extension_init);
  pr_info("%s: args: name=%s\n", MODULE_NAME, name);
  if (&extension_init != NULL) return extension_init();
  return 0;
}

extern void extension_exit(void) __attribute__((weak));
static void __exit ext_exit(void)
{
    pr_info("%s: goodbye %s\n", MODULE_NAME, name);
    pr_info("%s: module unloaded from 0x%p\n", MODULE_NAME, extension_exit);
    if (&extension_exit != NULL) extension_exit();	    
}


void set_app_got(app_got_t* got) {
    app_got = got;
    // pr_info("%s: app_got set to 0x%p\n", MODULE_NAME, app_got);
}

module_init(ext_init);
module_exit(ext_exit);
EOF
}

# Process dependent modules and build KBUILD_EXTRA_SYMBOLS
declare -a kbuild_symvers
for dep_mod in "${dep_modules[@]}"; do
    found=0
    for search_dir in "${module_search_dirs[@]}"; do
	if [[ -f "$search_dir/$dep_mod" ]]; then
	    # Found the module, look for Module.symvers
	    if [[ -f "$search_dir/Module.symvers" ]]; then
		symvers_path=$(realpath "$search_dir/Module.symvers")
		kbuild_symvers+=("$symvers_path")
		found=1
		break
	    else
		echo "ERROR: Module.symvers not found for $dep_mod in $search_dir" > /dev/stderr
		exit -1
	    fi
	fi
    done
    
    if (( ! found )); then
	echo "ERROR: Could not find $dep_mod in any of the specified search directories" > /dev/stderr
	exit -1
    fi
done

# Build ccflags-y with base directory and all -I includes
ccflags_content="-I $curdir"
for inc_dir in "${include_dirs[@]}"; do
    ccflags_content="$ccflags_content -I $(realpath $inc_dir)"
done

# Build KBUILD_EXTRA_SYMBOLS if we have dependencies
kbuild_extra_symbols=""
if (( ${#kbuild_symvers[@]} > 0 )); then
    kbuild_extra_symbols=$(IFS=' '; echo "${kbuild_symvers[*]}")
fi

[[ -n $kbuild_extra_symbols ]] && kbuild_extra_symbols="KBUILD_EXTRA_SYMBOLS := ${kbuild_extra_symbols}"

cat > $tmpdir/Makefile <<EOF
obj-m += ${name}.o
${name}-y := \$(patsubst %.c,%.o,${cfiles[@]}) \$(patsubst %.S,%.o,${asmfiles[@]}) init.o
ccflags-y := $ccflags_content

$kbuild_extra_symbols

KO_FILES := ${name}.ko 

.PHONY: all clean ${name}.ko

all: app.h ${name}.ko

%.kbin: %.ko
	ld -r -b binary -z noexecstack -o \$@ \$<

${name}.ko: ${cfiles[@]}
	make -C ${LINUX_BUILD_PATH} M=${tmpdir} modules

app.h: app_orig.h
	$scriptdir/genappheader app.h app_got.h app_orig.h

modules.h: ${name}.ko
	$scriptdir/genmodsheader -o modules.h \$(wildcard *.ko)

clean:
	make -C ${LINUX_BUILD_PATH} M=${tmpdir} clean
	-rm -rf \$(wildcard *.o ${name}.ko *.kbin)

EOF

make -C $tmpdir

(( $? )) && {
    echo "ERROR: look in $tmpdir" > /dev/stderr
    exit -1
}

rtdir=$(realpath --relative-to=$PWD $tmpdir)

[[ ! -a app.h ]] && ln -s $rtdir/app.h .

[[ -a $rtdir/$target ]] && mv $rtdir/$target $curdir/$target
[[ -a $rtdir/Module.symvers ]] && mv $rtdir/Module.symvers $curdir/Module.symvers

exit 0
