#!/bin/bash
#set -x
scriptdir=$(dirname $(realpath $0))
configdir=$scriptdir/config
srcdir=$scriptdir/src
kld=${srcdir}/kld/kld

findSymlib()
{
    function fsymlib() {
	if [[ -d Symlib ]]; then
	    echo $(pwd -P)/Symlib
	elif [[ $(pwd -P) != / ]]; then
	    cd ..
	    fsymlib
	fi
    }
    cd $scriptdir
    fsymlib
}

findlinuxdir()
{
    if [[ -d linux ]]; then
	echo $(pwd -P)/linux
    elif [[ $(pwd -P) != $HOME ]]; then
	cd ..
	findlinuxdir
    fi
}

usage()
{
    echo "USAGE: kcc [-o out] [-n name] [-I include_dir] [-K module_search_dir] [-k module.ko] [source]" > /dev/stderr
}

[[ -z $LINUX_BUILD_PATH ]] && [[ -a $configdir/LINUX_BUILD_PATH ]] \
    && LINUX_BUILD_PATH=$(< $configdir/LINUX_BUILD_PATH)

[[ -z $LINUX_BUILD_PATH ]] && LINUX_BUILD_PATH=$(findlinuxdir)

[[ -z $LINUX_BUILD_PATH ]] && {
    echo "ERROR: LINUX_BUILD_PATH not set.  Either environment variable to path of your linux build or put path in $configdir/LINUX_BUILD_PATH" > /dev/stderr
    exit -1
}

symlibdir=$(findSymlib)

[[ -z $symlibdir ]] && {
    echo "ERROR: can't seem to find a Symlib. Need to checkout Symlib and build it." > /dev/stderr
    exit -1
}
   
[[ -d $symlibdir/dynam_build/libSym.so ]] && {
    echo "ERROR: can't find $symlibdir/dynam_build/libSym.so ... maybe you need to build it." > /dev/stderr 
    exit -1
}

LINUX_BUILD_PATH=${LINUX_BUILD_PATH:-$(realpath ../linux)}
curdir=$PWD
tmpdir=$curdir/.ext

[[ ! -d $tmpdir ]] && mkdir $tmpdir

target=ext.ko
name=${target%.ko}
typeset -i topt=0
typeset -i nopt=0
declare -a include_dirs
declare -a module_search_dirs
declare -a dep_modules

while getopts ":n:o:I:K:k:h" o; do
    case "${o}" in
	h)
	    usage
	    exit 1
	    ;;
	n)
	    name=${OPTARG}
	    nopt=1
	    ;;
	o)
	    target=${OPTARG}
	    topt=1
	    ;;
	I)
	    include_dirs+=("${OPTARG}")
	    ;;
	K)
	    module_search_dirs+=("${OPTARG}")
	    ;;
	k)
	    dep_modules+=("${OPTARG}")
	    ;;
	*)
	    usage
	    exit 1
	    ;;
    esac
done
shift $((OPTIND-1))

(( topt && !nopt )) && {
    name=${target%.ko}
}

if (( $# > 0 )); then
    src=( $@ )
else
    src=( $(find $PWD -maxdepth 1 -name '*.kc' -o -name '*.kh' -o  -name '*.kS') )
fi

(( ! ${#src[@]} ))  && {
    echo "No .kc, .kh or .kS source files" > /dev/stderr
    usage
    exit -1
}

mods=( $(find $PWD -maxdepth 1 -name '*.ko') )
for m in ${mods[@]}; do
    #create a symlink to the .ko in the tmpdir if it doesn't already exist
    [[ ! -a $tmpdir/$(basename $m) ]] && ln -s $m $tmpdir/$(basename $m)
done

has_app_kh=0
declare -a cfiles
declare -a asmfiles

for s in ${src[@]}; do
    [[ ! -a $s ]] && {
	echo "Can't find $s" > /dev/stderr
	continue
    }
    
    # app.kh needs special treatment. It needs to be referenced by a symlink "app_orig.h" in the tmpdir.
    # genappheader then generates app.h (extern decls + wrappers) and app_init.h (slot definitions).
    if [[ $s == *app.kh ]]; then
	[[ ! -a $tmpdir/app_orig.h ]] && ln -s $s $tmpdir/app_orig.h
	has_app_kh=1
	continue
    fi

    if [[ $s =~ \.kc$ ]]; then 
	t=$(basename ${s%.kc}.c)
	cfiles+=($t)
    elif [[ $s =~ \.kh$ ]]; then
	t=$(basename ${s})
	hfiles+=($t)
    else
	t=$(basename ${s%.kS}.S)
	asmfiles+=($t)
    fi
    [[ ! -a $tmpdir/$t ]] && ln -s $s $tmpdir/$t
done

# When no app.kh is provided, remove stale back-linkage artefacts from prior
# builds so they cannot silently influence the current build.  Also warn if any
# source still includes "app.h" — it will fail to compile without an app.kh.
if (( ! has_app_kh )); then
    for s in "${src[@]}"; do
        [[ $s =~ \.kc$ ]] || continue
        grep -qF '#include "app.h"' "$s" 2>/dev/null && \
            echo "kcc: warning: $(basename $s) includes \"app.h\" but no app.kh was provided" >&2
    done
    rm -f "$tmpdir/app_orig.h" "$tmpdir/app.h" "$tmpdir/app_init.h" "$tmpdir/applink.c"
    rm -f "$curdir/app.h" "$curdir/applink.o"
fi

# Parse app_orig.h and build resolver body — only when app.kh was provided.
declare -a user_syms
resolver_body=""
if (( has_app_kh )); then
    # Parse app_orig.h to get user symbol names in declaration order.
    # Both init.c and applink.c are generated from the same list in the same
    # kcc run, so they always agree on symbol names.
    while IFS= read -r line; do
        [[ -z "$line" || "$line" =~ ^[[:space:]]*(#|//|/\*|\*) ]] && continue
        if [[ "$line" =~ [[:space:]\*]([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*\( ]]; then
            user_syms+=("${BASH_REMATCH[1]}")
        elif [[ "$line" =~ [[:space:]\*]([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*\; ]]; then
            user_syms+=("${BASH_REMATCH[1]}")
        fi
    done < "$tmpdir/app_orig.h"

    # Build the resolver body: one name-matched assignment per user symbol.
    # Order of symbols in app.kh does not matter — eliminates positional coupling.
    for sym in "${user_syms[@]}"; do
        resolver_body="${resolver_body}        if (strcmp(names[i], \"${sym}\") == 0) __user_sym__${sym} = addrs[i];\n"
    done
fi

# Always regenerate init.c so changes to app.kh are picked up on every run.
cat > $tmpdir/init.c <<EOF
#include <linux/module.h>
EOF

if (( has_app_kh )); then
    cat >> $tmpdir/init.c <<EOF
#include <linux/string.h>
#include "app.h"
#include "app_init.h"
EOF
fi

cat >> $tmpdir/init.c <<EOF

//  Define the module metadata.
#define MODULE_NAME "$name"
MODULE_AUTHOR("BU SESA");
MODULE_LICENSE("GPL v2");
MODULE_DESCRIPTION("BU SESA DYNPRIV PROCESS EXTENSION");
MODULE_VERSION("0.1b");

//  Define the name parameter.
static char *name = "dynpriv extension";
module_param(name, charp, S_IRUGO);
MODULE_PARM_DESC(name, "The name to display in /var/log/kern.log");

extern int extension_init(void) __attribute__((weak));
static int __init ext_init(void)
{
  pr_info("%s: module loaded at 0x%p\n", MODULE_NAME, extension_init);
  pr_info("%s: args: name=%s\n", MODULE_NAME, name);
  if (&extension_init != NULL) return extension_init();
  return 0;
}

extern void extension_exit(void) __attribute__((weak));
static void __exit ext_exit(void)
{
    pr_info("%s: goodbye %s\n", MODULE_NAME, name);
    pr_info("%s: module unloaded from 0x%p\n", MODULE_NAME, extension_exit);
    if (&extension_exit != NULL) extension_exit();	    
}
EOF

if (( has_app_kh )); then
    cat >> $tmpdir/init.c <<EOF

/*
 * __kld_resolve_app_syms_${name} — called by the user-space applink constructor.
 *
 * Receives the user symbol name array and pre-resolved addresses (obtained via
 * dlsym at ring 3) and assigns each address to the matching __user_sym__* slot
 * by name.  Order of names[] / addrs[] does not need to match app.kh order.
 * Must be called from elevated context (sym_elevate() active) since the slots
 * reside in kernel memory.
 */
void __kld_resolve_app_syms_${name}(const char * const *names, void **addrs, int count);
void __kld_resolve_app_syms_${name}(const char * const *names, void **addrs, int count)
{
    int i;
    for (i = 0; i < count; i++) {
$(printf "%b" "$resolver_body")    }
}
EXPORT_SYMBOL(__kld_resolve_app_syms_${name});
EOF
fi

cat >> $tmpdir/init.c <<EOF

module_init(ext_init);
module_exit(ext_exit);
EOF

# Process dependent modules and build KBUILD_EXTRA_SYMBOLS
declare -a kbuild_symvers
for dep_mod in "${dep_modules[@]}"; do
    # Absolute paths (e.g. /proc/kallsyms) are passed directly to kld — skip dir search
    [[ "$dep_mod" = /* ]] && continue
    found=0
    for search_dir in "${module_search_dirs[@]}"; do
	if [[ -f "$search_dir/$dep_mod" ]]; then
	    # Found the module, look for Module.symvers
	    if [[ -f "$search_dir/Module.symvers" ]]; then
		symvers_path=$(realpath "$search_dir/Module.symvers")
		kbuild_symvers+=("$symvers_path")
		found=1
		break
	    else
		echo "WARNING: Module.symvers not found for $dep_mod in $search_dir" > /dev/stderr
#		exit -1
	    fi
	fi
    done
    
    if (( ! found )); then
	echo "WARNING: Could not find $dep_mod in any of the specified search directories" > /dev/stderr
#	exit -1
    fi
done

# Build ccflags-y with base directory and all -I includes
ccflags_content="-I $curdir"
for inc_dir in "${include_dirs[@]}"; do
    ccflags_content="$ccflags_content -I $(realpath $inc_dir)"
done

# Build KBUILD_EXTRA_SYMBOLS if we have dependencies
kbuild_extra_symbols=""
if (( ${#kbuild_symvers[@]} > 0 )); then
    kbuild_extra_symbols=$(IFS=' '; echo "${kbuild_symvers[*]}")
fi

[[ -n $kbuild_extra_symbols ]] && kbuild_extra_symbols="KBUILD_EXTRA_SYMBOLS := ${kbuild_extra_symbols}"

# Set Makefile all-target list based on whether app.kh was provided.
if (( has_app_kh )); then
    _makefile_all_targets="app.h app_init.h ${name}.ko"
else
    _makefile_all_targets="${name}.ko"
fi

cat > $tmpdir/Makefile <<EOF
obj-m += ${name}.o
${name}-y := \$(patsubst %.c,%.o,${cfiles[@]}) \$(patsubst %.S,%.o,${asmfiles[@]}) init.o
ccflags-y := $ccflags_content

$kbuild_extra_symbols

KO_FILES := ${name}.ko 

.PHONY: all clean ${name}.ko

all: ${_makefile_all_targets}

%.kbin: %.ko
	ld -r -b binary -z noexecstack -o \$@ \$<

${name}.ko: ${cfiles[@]}
	make -C ${LINUX_BUILD_PATH} M=${tmpdir} modules

modules.h: ${name}.ko
	$scriptdir/genmodsheader -o modules.h \$(wildcard *.ko)

clean:
	make -C ${LINUX_BUILD_PATH} M=${tmpdir} clean
	-rm -rf \$(wildcard *.o ${name}.ko *.kbin)

EOF

if (( has_app_kh )); then
    cat >> $tmpdir/Makefile <<EOF
# genappheader generates both app.h and app_init.h from app_orig.h (symlink to app.kh)
app.h: app_orig.h
	$scriptdir/genappheader app.h app_init.h app_orig.h

# app_init.h is a side-effect of building app.h
app_init.h: app.h
	@:

EOF
fi

make -C $tmpdir

(( $? )) && {
    echo "ERROR: look in $tmpdir" > /dev/stderr
    exit -1
}

rtdir=$(realpath --relative-to=$PWD $tmpdir)

(( has_app_kh )) && [[ ! -a app.h ]] && ln -s $rtdir/app.h .

[[ -a $rtdir/$target ]] && {
    mv $rtdir/$target $curdir/$target
    declare -a kld_args
    for d in "${module_search_dirs[@]}"; do kld_args+=(-K "$d"); done
    for m in "${dep_modules[@]}";        do kld_args+=(-k "$m"); done
    ${kld} "${kld_args[@]}" -k "$target"
}

[[ -a $rtdir/Module.symvers ]] && mv $rtdir/Module.symvers $curdir/Module.symvers

# ---------------------------------------------------------------------------
# Generate and compile applink.c -> applink.o — only when app.kh was provided.
# ---------------------------------------------------------------------------
if (( has_app_kh )); then

# Collect resolver names: primary module + any dep modules that have app.kh
declare -a resolvers
resolvers+=("__kld_resolve_app_syms_${name}")
for dep_mod in "${dep_modules[@]}"; do
    [[ "$dep_mod" = /* ]] && continue
    depname=$(basename "${dep_mod%.ko}")
    for search_dir in "${module_search_dirs[@]}"; do
        if [[ -f "$search_dir/$dep_mod" && -f "$search_dir/app.kh" ]]; then
            resolvers+=("__kld_resolve_app_syms_${depname}")
            break
        fi
    done
done

# Build initialisers for both arrays in applink.c
resolver_init=""
for r in "${resolvers[@]}"; do
    resolver_init="${resolver_init}    \"${r}\",\n"
done

sym_init=""
for s in "${user_syms[@]}"; do
    sym_init="${sym_init}    \"${s}\",\n"
done

cat > $tmpdir/applink.c <<EOF
/* Generated by kcc — DO NOT EDIT */
/* Link this object directly into the user binary (not as a static archive).
 * Also link the binary with -rdynamic so dlsym(RTLD_DEFAULT, ...) can find
 * symbols from the executable itself. */
#define _GNU_SOURCE
#include <stdio.h>
#include <dlfcn.h>
#include "L0/sym_lib.h"

/* Resolver functions exported by each kernel module library (lib<mod>.so). */
static const char * const __kld_resolver_names[] = {
$(printf "$resolver_init")    NULL
};

/* User symbol names in app.kh declaration order — must match init.c resolver. */
static const char * const __kld_user_sym_names[] = {
$(printf "$sym_init")    NULL
};

/*
 * __kld_app_link — user-space constructor, runs after ld.so initialises all
 * shared libraries but before main().
 *
 * Phase 1 (ring 3): dlsym all user symbols and locate resolver functions.
 * All fprintf/write syscalls are confined to this phase (ring 3 only).
 *
 * Phase 2 (ring 0): elevate, call each resolver with the pre-resolved address
 * array so it can write directly into the __user_sym__* slots in kernel memory,
 * then lower.  No stdio or syscalls during this phase.
 */
__attribute__((constructor(200)))
static void __kld_app_link(void)
{
    typedef void (*resolver_t)(const char * const *, void **, int);
    const char * const *sp, * const *rp;
    resolver_t res_fns[sizeof(__kld_resolver_names)/sizeof(__kld_resolver_names[0])];
    void *user_addrs[64]; /* generous upper bound; one entry per app.kh symbol */
    int nsyms = 0, nres = 0, i;

    /* Phase 1a: resolve user-space symbols via dlsym (safe at ring 3). */
    for (sp = __kld_user_sym_names; *sp; sp++) {
        user_addrs[nsyms] = dlsym(RTLD_DEFAULT, *sp);
        if (!user_addrs[nsyms])
            fprintf(stderr, "kld applink: user symbol '%s' not found\\n", *sp);
        nsyms++;
    }

    /* Phase 1b: locate kernel module resolver functions. */
    for (rp = __kld_resolver_names; *rp; rp++) {
        res_fns[nres] = (resolver_t)dlsym(RTLD_DEFAULT, *rp);
        if (!res_fns[nres])
            fprintf(stderr, "kld applink: resolver '%s' not found\\n", *rp);
        else
            nres++;
    }

    if (!nres) {
        fprintf(stderr, "kld applink: warning: no resolvers available\\n");
        return;
    }

    /* Phase 2: elevate and write pre-resolved addresses into kernel slots. */
    sym_elevate();
    for (i = 0; i < nres; i++)
        res_fns[i](__kld_user_sym_names, user_addrs, nsyms);
    symbi_fast_lower();
}
EOF

gcc -O2 -fPIC -I${symlibdir}/include -c -o $curdir/applink.o $tmpdir/applink.c
(( $? )) && {
    echo "ERROR: failed to compile applink.c" > /dev/stderr
    exit -1
}

echo "kcc: generated applink.o — add to your binary link command with -rdynamic"

fi  # has_app_kh

exit 0
