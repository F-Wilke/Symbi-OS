#!/bin/bash
#set -x
typeset -r KOTBL=${KOTBL:-kotbl.bin}
scriptdir=$(dirname $(realpath $0))
interp=${KLDSO:-${scriptdir}/kld.so}
binary=$1

[[ ! -a $interp ]] && {
    echo "ERROR: can't find interpreter: $interp" >&2
    exit -1
}

[[ -z $binary ]] && {
    echo "USAGE: $0 <binary>" >&2
    echo "       sets the interpreter specified binary to $interp"
    exit 0
}

echo -n "current interpters for $binary: "

if patchelf --print-interpreter $binary; then
    patchelf --set-interpreter $interp $binary
    echo -n "now: "
    patchelf --print-interpreter $binary
fi

[[ -a $KOTBL ]] && {
    # following was generated with github copilot (Claude Haiku 4.5)
    # Add the section with appropriate flags:
    # - readonly: section is read-only
    # - noload: section is not loaded into memory by the loader
    # - contents: section has actual content
    # - Note: We do NOT use alloc or load since this is not meant to be loaded
    objcopy --add-section .kotbl="$KOTBL" \
        --set-section-flags .kotbl=readonly,noload,contents \
        "$binary"
}

    
