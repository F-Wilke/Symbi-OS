#!/usr/bin/python3
"""
genappheader — generate kernel-side app.h and app_init.h from app.kh

Usage: genappheader <app.h> <app_init.h> <app.kh>

Parses plain C declarations in app.kh — no tags required.
Functions (have a parameter list) and data (no parens) are auto-detected:

  int user_add(int a, int b);
  void user_printf(const char *fmt, ...);   # variadic -> #define macro
  int user_counter;
  struct my_stats user_stats;

Lines starting with #, //, /*, or * are skipped (preprocessor / comments).

Generates:
  app.h      — extern slot declarations + typed call wrappers (kernel-side)
  app_init.h — void* slot definitions, include ONCE from init.c
"""

import sys
import re
import os


# --------------------------------------------------------------------------- #
# Parsing helpers
# --------------------------------------------------------------------------- #

def _split_type_name(s):
    """Split 'int *get_ptr' or 'struct foo bar' into (type, name).

    Leading '*' characters are moved from the name token to the type.
    """
    s = s.strip()
    tokens = s.rsplit(None, 1)
    if len(tokens) != 2:
        return '', s
    type_part, name_part = tokens
    while name_part.startswith('*'):
        type_part += '*'
        name_part = name_part[1:]
    return type_part.strip(), name_part.strip()


def _parse_params(params_str):
    """Parse a parameter list string.

    Returns (typed_params, arg_names, is_variadic) where:
      typed_params — list of 'type name' strings (e.g. ['int a', 'int b'])
      arg_names    — list of bare argument names (e.g. ['a', 'b'])
      is_variadic  — True if '...' was present
    """
    params_str = params_str.strip()
    if not params_str or params_str == 'void':
        return [], [], False

    parts = [p.strip() for p in params_str.split(',')]
    is_variadic = '...' in parts
    parts = [p for p in parts if p != '...']

    typed = []
    names = []
    for i, p in enumerate(parts):
        type_part, name_part = _split_type_name(p)
        if not name_part:
            # Unnamed param — generate a placeholder
            type_part = p.strip()
            name_part = f'_p{i}'
        typed.append(f'{type_part} {name_part}')
        names.append(name_part)

    return typed, names, is_variadic


def _type_only(typed_params):
    """Strip parameter names, keeping only types for function-pointer casts."""
    result = []
    for p in typed_params:
        t, _ = _split_type_name(p)
        result.append(t if t else p)
    return result


# --------------------------------------------------------------------------- #
# Parser
# --------------------------------------------------------------------------- #

# Matches: <rettype+name> ( <params> ) ;   — function declaration
_FN_PAT = re.compile(r'(.+\b)\s*\(([^)]*)\)\s*;')

# Matches: <type+name> ;                   — data declaration (fallback)
_DATA_PAT = re.compile(r'(.+?)\s*;')


def parse_kh(kh_path):
    """Parse app.kh and return a list of symbol descriptors."""
    symbols = []

    with open(kh_path) as f:
        for line in f:
            stripped = line.strip()
            if not stripped or stripped.startswith('//') or stripped.startswith('#') \
                    or stripped.startswith('/*') or stripped.startswith('*'):
                continue

            m = _FN_PAT.search(stripped)
            if m:
                rettype, fname = _split_type_name(m.group(1))
                typed_params, arg_names, is_variadic = _parse_params(m.group(2))
                symbols.append({
                    'kind': 'fn',
                    'name': fname,
                    'rettype': rettype,
                    'typed_params': typed_params,
                    'arg_names': arg_names,
                    'is_variadic': is_variadic,
                    'original': stripped,
                })
                continue

            m = _DATA_PAT.search(stripped)
            if m:
                dtype, dname = _split_type_name(m.group(1))
                symbols.append({
                    'kind': 'data',
                    'name': dname,
                    'dtype': dtype,
                    'original': stripped,
                })

    return symbols


# --------------------------------------------------------------------------- #
# Code generators
# --------------------------------------------------------------------------- #

def generate_app_h(symbols, kh_path):
    """Generate kernel-side app.h."""
    guard = 'APP_H_EXT_'
    lines = [
        '/* Generated by genappheader — DO NOT EDIT */',
        f'/* Source: {os.path.basename(kh_path)} */',
        f'#ifndef {guard}',
        f'#define {guard}',
        '',
        '#include <linux/kernel.h>',
        '',
    ]

    if not symbols:
        lines.append(f'#endif /* {guard} */')
        return '\n'.join(lines) + '\n'

    # One extern declaration per slot
    lines.append('/* User-symbol pointer slots — defined once in app_init.h (included by init.c) */')
    for sym in symbols:
        lines.append(f'extern void *__user_sym__{sym["name"]};')
    lines.append('')

    # Typed call wrappers
    lines.append('/* Kernel-side call wrappers */')
    for sym in symbols:
        lines.append(f'/* {sym["original"]} */')
        name = sym['name']

        if sym['kind'] == 'fn':
            rettype = sym['rettype']
            typed_params = sym['typed_params']
            arg_names = sym['arg_names']
            is_variadic = sym['is_variadic']

            if is_variadic:
                # Variadic: emit a #define macro
                fixed_types = _type_only(typed_params)
                fixed_str = (', '.join(fixed_types) + ', ...') if fixed_types else '...'
                lines.append(
                    f'#define {name}(...) '
                    f'(({rettype}(*)({fixed_str}))__user_sym__{name})(__VA_ARGS__)'
                )
            else:
                # Non-variadic: static inline wrapper
                param_types = _type_only(typed_params)
                fn_ptr = f'{rettype}(*)({", ".join(param_types) if param_types else "void"})'
                param_decl = ', '.join(typed_params) if typed_params else 'void'
                call_args = ', '.join(arg_names)
                ret_kw = 'return ' if rettype != 'void' else ''
                lines.append(f'static inline {rettype} {name}({param_decl})')
                lines.append('{')
                lines.append(f'    {ret_kw}(({fn_ptr})__user_sym__{name})({call_args});')
                lines.append('}')

        else:  # data
            dtype = sym['dtype']
            lines.append(f'#define {name} (*({dtype} *)__user_sym__{name})')

        lines.append('')

    lines.append(f'#endif /* {guard} */')
    return '\n'.join(lines) + '\n'


def generate_app_init_h(symbols, kh_path):
    """Generate app_init.h — slot definitions for inclusion in init.c."""
    lines = [
        '/* Generated by genappheader — DO NOT EDIT */',
        f'/* Source: {os.path.basename(kh_path)} */',
        '/* Include ONCE from init.c to define the __user_sym__ pointer slots */',
        '',
    ]

    if not symbols:
        lines.append('/* No user symbols declared */')
    else:
        for sym in symbols:
            lines.append(f'void *__user_sym__{sym["name"]} = NULL;')

    return '\n'.join(lines) + '\n'


# --------------------------------------------------------------------------- #
# Entry point
# --------------------------------------------------------------------------- #

if __name__ == '__main__':
    if len(sys.argv) != 4:
        print(f'Usage: {sys.argv[0]} <app.h> <app_init.h> <app.kh>', file=sys.stderr)
        sys.exit(1)

    app_h_path     = sys.argv[1]
    app_init_h_path = sys.argv[2]
    kh_path        = sys.argv[3]

    if not os.path.exists(kh_path):
        print(f'Error: {kh_path} not found', file=sys.stderr)
        sys.exit(1)

    symbols = parse_kh(kh_path)

    with open(app_h_path, 'w') as f:
        f.write(generate_app_h(symbols, kh_path))

    with open(app_init_h_path, 'w') as f:
        f.write(generate_app_init_h(symbols, kh_path))

    print(f'Generated {app_h_path} ({len(symbols)} symbol(s))')
    print(f'Generated {app_init_h_path}')
