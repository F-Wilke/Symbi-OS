#include <linux/module.h>
#include <linux/printk.h> 
#include <linux/module.h> 
#include "nmiadaptor.h"

void* nmi_adaptor_asm_exc_nmi;
EXPORT_SYMBOL(nmi_adaptor_asm_exc_nmi);

EXPORT_SYMBOL(nmi_asm_check_ist7);


#ifdef DEBUG
extern int nmi_asm_debug(int normalNMI);
#endif

int extension_init(void);

int extension_init(void)
{
#ifdef DEBUG
    //try normal nmi, expect retval 0
    int retVal;
    retVal = nmi_asm_debug(1);
    pr_info("nmi_asm_debug(1): %d, expected 0", retVal);
    
    //try IST7 nmi, expect retval 1
    retVal = nmi_asm_debug(0);
    pr_info("nmi_asm_debug(0): %d, expected 1", retVal);
#endif
    pr_info("nmi_asm_check_ist7 is at 0x%llx", (unsigned long long)&nmi_asm_check_ist7);

    return 0;
}
MODULE_INFO(kld, "SHARED");
